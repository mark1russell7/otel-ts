{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/otel-sink",
  "version": "0.1.1",
  "description": "An OTLP/HTTP JSON receiver for one computer: spans, logs and metric points in one SQLite file, with retention rules and queries over HTTP.",
  "keywords": [
    "opentelemetry",
    "otlp",
    "sqlite",
    "traces",
    "logs",
    "metrics",
    "retention"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "bin": {
    "otel-sink": "./src/main.ts"
  },
  "files": [
    "dist",
    "!dist/**/.tsbuildinfo",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test-util.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "bin": {
      "otel-sink": "./dist/main.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/otel-ts.git",
    "directory": "packages/otel-sink"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "homepage": "https://github.com/mark1russell7/otel-ts/tree/main/packages/otel-sink#readme",
  "bugs": {
    "url": "https://github.com/mark1russell7/otel-ts/issues"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "start": "node src/main.ts"
  },
  "dependencies": {
    "@mark1russell7/otel-ts": "^0.11.2",
    "@mark1russell7/service": "^0.13.0",
    "@mark1russell7/sqlite": "^0.7.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.1.1",
    "@opentelemetry/core": "^3.1.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.301.2",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "@opentelemetry/semantic-conventions": "^1.40.0"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.0.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^4.1.12",
    "typescript": "^5.9.0",
    "vitest": "^4.1.12"
  }
}
