{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/otel-ts",
  "version": "0.10.3",
  "description": "Frontend observability in one init() call — OpenTelemetry + Grafana Faro for any TypeScript web app",
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "homepage": "https://github.com/mark1russell7/otel-ts#readme",
  "bugs": {
    "url": "https://github.com/mark1russell7/otel-ts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/otel-ts.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.15.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./zone": {
      "types": "./dist/zone.d.ts",
      "import": "./dist/zone.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./context": {
      "types": "./dist/context.d.ts",
      "import": "./dist/context.js"
    },
    "./incoming-span": {
      "types": "./dist/incoming-span.d.ts",
      "import": "./dist/incoming-span.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./node/context": {
      "types": "./dist/node-context.d.ts",
      "import": "./dist/node-context.js"
    },
    "./node/testing": {
      "types": "./dist/node-testing.d.ts",
      "import": "./dist/node-testing.js"
    },
    "./lag": {
      "types": "./dist/lag.d.ts",
      "import": "./dist/lag.js"
    },
    "./pull": {
      "types": "./dist/pull.d.ts",
      "import": "./dist/pull.js"
    },
    "./error": {
      "types": "./dist/error-record.d.ts",
      "import": "./dist/error-record.js"
    },
    "./error-view": {
      "types": "./dist/error-view.d.ts",
      "import": "./dist/error-view.js"
    },
    "./call-trace": {
      "types": "./dist/call-trace.d.ts",
      "import": "./dist/call-trace.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "clean": "rm -rf dist .tsbuildinfo",
    "infra:up": "cd node_modules/@mark1russell7/grafana-infra && docker compose up -d",
    "infra:down": "cd node_modules/@mark1russell7/grafana-infra && docker compose down",
    "infra:logs": "cd node_modules/@mark1russell7/grafana-infra && docker compose logs -f",
    "test": "vitest run",
    "check:conventions": "conventions check",
    "check:api": "api-report check"
  },
  "dependencies": {
    "@grafana/faro-web-sdk": "^2.13.0",
    "@mark1russell7/text": "^0.0.20",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-web": "^0.70.1",
    "@opentelemetry/context-async-hooks": "^3.1.1",
    "@opentelemetry/context-zone": "^3.1.1",
    "@opentelemetry/core": "^3.1.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.301.2",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.301.2",
    "@opentelemetry/instrumentation": "^0.301.2",
    "@opentelemetry/instrumentation-long-task": "^0.69.0",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "async-browser-context": "^0.3.0",
    "page-lifecycle-tracker": "^0.1.0"
  },
  "peerDependencies": {
    "@mark1russell7/lag": ">=0.4.2 <0.6.0",
    "@opentelemetry/sdk-node": ">=0.300.0 <0.400.0"
  },
  "peerDependenciesMeta": {
    "@mark1russell7/lag": {
      "optional": true
    },
    "@opentelemetry/sdk-node": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mark1russell7/api-report": "^0.5.22",
    "@mark1russell7/conventions": "^0.52.8",
    "@mark1russell7/grafana-infra": "github:mark1russell7/grafana-infra#618d1ab7042455f81a81e219af6d33022551305e",
    "@mark1russell7/lag": "^0.5.0",
    "@mark1russell7/rigor-bench": "^0.3.2",
    "@mark1russell7/rigor-testkit": "^0.2.0",
    "@opentelemetry/sdk-node": "~0.301.2",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^4.1.12",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.0",
    "vitest": "^4.1.12"
  },
  "conventions": {
    "rules": {
      "no-console": {
        "baseline": 2,
        "failFrom": "2026-12-23",
        "reason": "Wave 2 of the no-console plan: src has 2 console calls. A new call fails at once, and the last ones fail from 2026-12-23."
      }
    }
  }
}
