{
  "$schema": "https://json.schemastore.org/package",
  "name": "@otel-ts/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The GitHub Pages site of otel-ts: the real init() runs in the page, and each span, metric and log record shows as it leaves the package.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@mark1russell7/otel-ts": "workspace:*",
    "@mark1russell7/site-pages": "^0.2.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.213.0"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.0.0",
    "@types/node": "^26.6.5",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.0",
    "vite": "^8.3.3",
    "vitest": "^4.1.11"
  }
}
